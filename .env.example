# Copie ce fichier en .env pour le développement.
# Base locale : docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://cap:cap@localhost:5432/cap"
DIRECT_URL="postgresql://cap:cap@localhost:5432/cap"

# Photos : sur le disque en local. Définir S3_BUCKET pour utiliser S3.
UPLOAD_DIR=".uploads"
# S3_BUCKET=""
# S3_REGION="eu-west-3"

SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-moi-en-local"
