# Données : fichier JSON local par défaut. Pour DynamoDB, définir DYNAMODB_TABLE
# (et DYNAMODB_ENDPOINT=http://localhost:8000 pour DynamoDB Local).
DATA_FILE=".data/cap.json"
# DYNAMODB_TABLE="notre-cap"
# DYNAMODB_REGION="eu-west-3"

# Photos : sur le disque par défaut, dans S3 si S3_BUCKET est défini.
UPLOAD_DIR=".uploads"
# S3_BUCKET="notre-cap-photos"
# S3_REGION="eu-west-3"

SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-moi"
